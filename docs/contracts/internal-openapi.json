{
  "openapi": "3.1.0",
  "info": {
    "title": "MicroLens Internal Model Activation API",
    "description": "Compose-internal publishing runtime; never host-published.",
    "version": "0.2.0-phase2d",
    "x-implementation-status": "phase_2d_internal_runtime"
  },
  "paths": {
    "/internal/model-versions/{version}/activate": {
      "post": {
        "tags": [
          "internal"
        ],
        "summary": "Activate Model",
        "operationId": "activateModelVersion",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Version"
            }
          },
          {
            "name": "X-Publish-Token",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Publish-Token"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActivationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelVersion"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "publishToken": []
          }
        ],
        "x-internal-only": true
      }
    }
  },
  "components": {
    "schemas": {
      "ActivationRequest": {
        "properties": {
          "expected_current_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Current Version"
          },
          "manifest_checksum": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Manifest Checksum"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_current_version",
          "manifest_checksum"
        ],
        "title": "ActivationRequest"
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id",
          "details"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "details": {}
        }
      },
      "ModelVersion": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "data_version": {
            "type": "string",
            "title": "Data Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "TRAINING",
              "EVALUATED",
              "READY",
              "ACTIVE",
              "ARCHIVED",
              "FAILED"
            ],
            "title": "Status"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "base_official",
              "systems_only",
              "quality_evaluation"
            ],
            "title": "Purpose"
          },
          "evaluation_comparability": {
            "type": "string",
            "enum": [
              "non_comparable",
              "comparable"
            ],
            "title": "Evaluation Comparability"
          },
          "activation_eligible": {
            "type": "boolean",
            "title": "Activation Eligible"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics"
          },
          "trained_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trained At"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "model_version",
          "data_version",
          "status",
          "purpose",
          "evaluation_comparability",
          "activation_eligible",
          "metrics",
          "trained_at",
          "published_at"
        ],
        "title": "ModelVersion"
      }
    },
    "securitySchemes": {
      "publishToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Publish-Token"
      }
    },
    "responses": {
      "Error": {
        "description": "Internal publishing error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://api:8001",
      "description": "Non-host-published Compose backend listener"
    }
  ],
  "x-listener-contract": {
    "host_published": false,
    "compose_network": "backend",
    "network_scope": "compose-internal-only",
    "public_listener_rejects": [
      "/internal/"
    ]
  }
}
