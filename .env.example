# Copy this file to .env and replace every REQUIRED value locally.
# Never commit .env. Values below are placeholders, not credentials.

COMPOSE_PROJECT_NAME=microlens-mvp
WEB_PORT=5173
API_PORT=8000

POSTGRES_DB=microlens
POSTGRES_USER=microlens_app
POSTGRES_PASSWORD=REQUIRED_GENERATE_A_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://microlens_app:REQUIRED_GENERATE_A_RANDOM_PASSWORD@db:5432/microlens

REDIS_URL=redis://redis:6379/0

# Generate independently for local use. Do not reuse POSTGRES_PASSWORD.
JWT_SECRET=REQUIRED_GENERATE_AT_LEAST_32_RANDOM_BYTES
PUBLISH_TOKEN=REQUIRED_GENERATE_AN_INDEPENDENT_RANDOM_TOKEN
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=microlens_csrf
SESSION_COOKIE_NAME=microlens_session

MODEL_ARTIFACTS_DIR=/artifacts/models
TRAINING_EXPORTS_DIR=/artifacts/training_exports
MICROLENS_DATA_DIR=./dataset
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
