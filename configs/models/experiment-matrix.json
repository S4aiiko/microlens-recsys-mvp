{
  "schema_version": "2.0",
  "phase": "7A",
  "base_config": "configs/models/full-a.json",
  "execution_policy": "serial_validation_selection_then_single_test_final",
  "selection": {
    "metric": "two_stage.ndcg@20",
    "direction": "maximize",
    "tie_break": "experiment_id_ascending",
    "test_policy": "selected_configuration_only_once"
  },
  "model_experiments": [
    {"experiment_id": "negative-uniform", "override_path": "dssm.negative_sampling", "value": "uniform", "control": "negative-uniform"},
    {"experiment_id": "negative-popularity", "override_path": "dssm.negative_sampling", "value": "popularity_aware", "control": "negative-uniform"},
    {"experiment_id": "decay-off", "override_path": "dssm.time_decay", "value": {"enabled": false, "half_life_seconds": 604800}, "control": "decay-off"},
    {"experiment_id": "decay-3d", "override_path": "dssm.time_decay", "value": {"enabled": true, "half_life_seconds": 259200}, "control": "decay-off"},
    {"experiment_id": "decay-14d", "override_path": "dssm.time_decay", "value": {"enabled": true, "half_life_seconds": 1209600}, "control": "decay-off"},
    {"experiment_id": "title-on", "override_path": "title.enabled", "value": true, "control": "title-on"},
    {"experiment_id": "title-off", "override_path": "title.enabled", "value": false, "control": "title-on"},
    {"experiment_id": "dssm-hparam-a", "override_path": "dssm", "value": {"embedding_dim": 12, "hidden_dims": [24], "output_dim": 12, "dropout": 0.0, "temperature": 0.2, "learning_rate": 0.01, "batch_size": 128, "epochs": 5, "patience": 2, "min_delta": 0.0001, "negative_sampling": "uniform", "negatives_per_positive": 2, "popularity_alpha": 0.75, "candidate_top_n": 200, "time_decay": {"enabled": false, "half_life_seconds": 604800}}, "control": "dssm-hparam-a"},
    {"experiment_id": "dssm-hparam-b", "override_path": "dssm", "value": {"embedding_dim": 16, "hidden_dims": [32, 16], "output_dim": 16, "dropout": 0.1, "temperature": 0.15, "learning_rate": 0.005, "batch_size": 128, "epochs": 6, "patience": 2, "min_delta": 0.0001, "negative_sampling": "uniform", "negatives_per_positive": 3, "popularity_alpha": 0.75, "candidate_top_n": 200, "time_decay": {"enabled": false, "half_life_seconds": 604800}}, "control": "dssm-hparam-a"},
    {"experiment_id": "deepfm-hparam-a", "override_path": "deepfm", "value": {"embedding_dim": 8, "hidden_dims": [32, 16], "dropout": 0.0, "learning_rate": 0.005, "batch_size": 128, "epochs": 5, "patience": 2, "min_delta": 0.0001, "negatives_per_positive": 3, "dense_features": ["dssm_recall_score", "title_history_similarity", "train_popularity_log_normalized", "train_novelty", "train_user_activity_log_normalized", "train_time_decay_weight"]}, "control": "deepfm-hparam-a"},
    {"experiment_id": "deepfm-hparam-b", "override_path": "deepfm", "value": {"embedding_dim": 12, "hidden_dims": [48, 24], "dropout": 0.1, "learning_rate": 0.002, "batch_size": 128, "epochs": 6, "patience": 2, "min_delta": 0.0001, "negatives_per_positive": 4, "dense_features": ["dssm_recall_score", "title_history_similarity", "train_popularity_log_normalized", "train_novelty", "train_user_activity_log_normalized", "train_time_decay_weight"]}, "control": "deepfm-hparam-a"}
  ],
  "serving_ablation": {
    "cohort": {
      "split": "test",
      "users": "all_split_users",
      "candidate_pool_size": 200,
      "candidate_policy": "serving_top_n_excluding_train_seen",
      "k": [5, 10, 20]
    },
    "experiments": [
      {"experiment_id": "recall-all", "enabled_sources": ["dssm", "item_item_cf", "profile_title"], "topic_dedup_enabled": false, "mmr_enabled": false},
      {"experiment_id": "recall-without-dssm", "enabled_sources": ["item_item_cf", "profile_title"], "topic_dedup_enabled": false, "mmr_enabled": false},
      {"experiment_id": "recall-without-cf", "enabled_sources": ["dssm", "profile_title"], "topic_dedup_enabled": false, "mmr_enabled": false},
      {"experiment_id": "recall-without-profile-title", "enabled_sources": ["dssm", "item_item_cf"], "topic_dedup_enabled": false, "mmr_enabled": false},
      {"experiment_id": "topic-dedup-on", "enabled_sources": ["dssm", "item_item_cf", "profile_title"], "topic_dedup_enabled": true, "mmr_enabled": false},
      {"experiment_id": "mmr-on", "enabled_sources": ["dssm", "item_item_cf", "profile_title"], "topic_dedup_enabled": false, "mmr_enabled": true}
    ]
  }
}
